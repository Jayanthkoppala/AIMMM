# Movement Network Configuration
MOVEMENT_RPC=https://testnet.movementnetwork.xyz/v1
MOVEMENT_NETWORK=movement-testnet

# Switchboard Oracle Configuration
# Comma-separated aggregator addresses (on-chain addresses)
# Format: 0x... (64-character hex addresses)
SWITCHBOARD_FEED_IDS=
SWITCHBOARD_API_URL=https://api.switchboard.xyz/api

# Uniswap V2 Configuration
UNISWAP_FACTORY_ADDRESS=
TOKEN_A_ADDRESS=
TOKEN_B_ADDRESS=

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# x402 Payment Configuration
X402_RECEIVER_ADDRESS=
X402_FACILITATOR_URL=https://facilitator.stableyard.fi
BASE_AGENT_COST_USDC=0.001

# Supabase Database Configuration
SUPABASE_URL=
SUPABASE_KEY=

# Agent Executor Contract
AGENT_EXECUTOR_ADDRESS=

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Logging Configuration
LOG_LEVEL=INFO

# Direct PostgreSQL Connection (Alternative to Supabase Client)
# Use either DATABASE_URL or individual DB settings
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.cplgfbngzklcxpzyxzef.supabase.co:5432/postgres

# Or use individual settings:
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=db.cplgfbngzklcxpzyxzef.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
